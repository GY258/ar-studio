{
  "name": "ar-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "assets": "bash scripts/fetch-assets.sh",
    "build:check": "NEXT_DIST_DIR=.next-build next build",
    "db:migrate": "psql \"$DATABASE_URL\" -f db/schema.sql",
