# 全部走密钥管理，不要提交真实值（PRD 9 章）
# 一个都不填也能跑：dev 模式会用内存态兜底，见 src/lib/db.ts 和 src/lib/auth.ts

# --- 认证 ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 支付 ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 数据库 ---
DATABASE_URL=

# --- 分析（可选）---
NEXT_PUBLIC_POSTHOG_KEY=

# MediaPipe 自托管（PRD 5.6）。不配就走 jsdelivr / storage.googleapis.com，国内不通。
#
# 本机开发：先跑 npm run assets 把文件拉到 public/vendor，再解开下面三行。
# 线上部署：public/vendor 在 .gitignore 里，产物里没有这些文件 ——
#   直接解开下面三行会让 /vendor/* 全部 404，整站白屏。
#   要在线上自托管，把文件传到 R2 / Blob，然后指向那个域名。
# NEXT_PUBLIC_WASM_BASE=/vendor/wasm
# NEXT_PUBLIC_SEG_MODEL=/vendor/selfie_segmenter.tflite
# NEXT_PUBLIC_FACE_MODEL=/vendor/face_landmarker.task
